{{- /*
  Machine-readable feed of all funding programs, served at /programs/index.json.
  Intended for other agents: fetch this one file and filter by `date` (when the
  program was added) or `lastmod` (when it was last changed) to find programs
  added or updated after a given date — no local snapshot required.
*/ -}}
{{- $programs := slice -}}
{{- range (where site.RegularPages "Section" "programs").ByDate.Reverse -}}
  {{- $programs = $programs | append (dict
    "slug" .File.ContentBaseName
    "url" .Permalink
    "title" .Title
    "subtitle" (.Params.subtitle | default "")
    "status" (.Params.status | default "")
    "tags" (.Params.tags | default slice)
    "deadline" (.Params.deadline | default "")
    "date" (.Date.Format "2006-01-02")
    "lastmod" (.Lastmod.Format "2006-01-02")
  ) -}}
{{- end -}}
{{- dict
  "generated" (now.Format "2006-01-02T15:04:05Z07:00")
  "count" (len $programs)
  "programs" $programs
| jsonify (dict "indent" "  ") -}}
